# ==========================================
# FRONTEND (Next.js) - Public variables
# Prefix with NEXT_PUBLIC_ for client exposure
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Wallet to display (public address only)
NEXT_PUBLIC_WALLET_ADDRESS=bc1qyour_wallet_address_here
NEXT_PUBLIC_WALLET_LABEL=BTC Wallet Prize

# ==========================================
# SECURITY (Frontend) - Public but rotate regularly
# ==========================================
# hCaptcha Site Key (get from https://dashboard.hcaptcha.com)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key

# HMAC Secret for request signing (client-side component)
# In production, derive this from a challenge-response, don't use static!
NEXT_PUBLIC_HMAC_SECRET=client-hmac-secret-change-me

# ==========================================
# BACKEND (Firebase Functions) - SECRET variables
# Set via: firebase functions:config:set key="value"
# DO NOT put secrets in .env.local for production!
# ==========================================
# MASTER_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# hCaptcha Secret Key (get from https://dashboard.hcaptcha.com)
# HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key