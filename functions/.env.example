# Firebase Functions Environment Variables
# Set via: firebase functions:config:set key="value"
# 
# DO NOT commit real values!
# This file is for local emulator testing only.

# Master Encryption Key (32 bytes base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# hCaptcha Secret Key (get from https://dashboard.hcaptcha.com)
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_here

# For local emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099