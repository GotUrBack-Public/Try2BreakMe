    "generate:seed": "node scripts/generate-seed.js",
    "encrypt:seed": "node scripts/encrypt-seed.js"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "webpack-obfuscator": "^3.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
